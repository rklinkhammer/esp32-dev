#!/usr/bin/env python3
"""Thin Docker launcher; all firmware operations belong to native ESP-IDF."""
import argparse
import os
from pathlib import Path
import shlex
import subprocess
import sys

ROOT = Path(__file__).resolve().parent


def parser():
    p = argparse.ArgumentParser(description=__doc__, epilog="Examples: ./esp32 --project ../dmotor/software/esp32 build; ./esp32 smoke")
    p.add_argument('--project', default=os.environ.get('ESP32_PROJECT', os.getcwd()))
    p.add_argument('--workspace', help='Mount root containing the project and shared sources (default: Git root)')
    p.add_argument('--target', default=os.environ.get('ESP32_TARGET', 'esp32s3'))
    p.add_argument('--port', help='Local serial device or RFC2217 URL; passed to idf.py')
    p.add_argument('--dry-run', action='store_true')
    p.add_argument('command', nargs='?', default='shell', help='pull, doctor, shell, smoke, idf, or any idf.py action')
    p.add_argument('args', nargs=argparse.REMAINDER, help='Arguments passed unchanged to idf.py (or shell)')
    return p


def launch(a):
    image = (ROOT / 'config/idf-image.txt').read_text().strip()
    if a.command == 'pull':
        return ['docker', 'pull', image]
    if a.command == 'doctor':
        print(f'Pinned image: {image}\nDefault target: {a.target}', flush=True)
        return ['docker', 'version']
    project = (ROOT / 'examples/smoke' if a.command == 'smoke' else Path(a.project)).resolve()
    if not project.is_dir():
        raise ValueError(f'Project directory does not exist: {project}')
    if a.workspace:
        workspace = Path(a.workspace).resolve()
    else:
        git = subprocess.run(['git', '-C', str(project), 'rev-parse', '--show-toplevel'], capture_output=True, text=True)
        workspace = Path(git.stdout.strip()) if git.returncode == 0 else project
    if not project.is_relative_to(workspace):
        raise ValueError('--project must be inside --workspace')
    if ',' in str(workspace):
        raise ValueError('Docker bind mount paths cannot contain commas')
    cache = ROOT / '.cache' / str(os.getuid())
    if not a.dry_run:
        cache.mkdir(parents=True, exist_ok=True)
    cmd = ['docker', 'run', '--rm', '--init', '--user', f'{os.getuid()}:{os.getgid()}',
           '--security-opt', 'no-new-privileges', '--cap-drop', 'ALL',
           '--mount', f'type=bind,src={workspace},dst={workspace}',
           '--mount', f'type=bind,src={cache},dst=/home/esp32',
           '--workdir', str(project), '-e', 'HOME=/home/esp32',
           '-e', f'IDF_TARGET={a.target}', '-e', 'IDF_CCACHE_ENABLE=1',
           '-e', 'CCACHE_DIR=/home/esp32/ccache']
    if sys.stdin.isatty():
        cmd += ['-it']
    if a.port:
        if '://' in a.port:
            cmd += ['--add-host', 'host.docker.internal:host-gateway']
        else:
            port = Path(a.port).resolve()
            if not port.is_char_device():
                raise ValueError(f'Not a serial character device: {port}')
            cmd += ['--device', f'{port}:{a.port}', '--group-add', str(port.stat().st_gid)]
    cmd.append(image)
    if a.command == 'shell':
        cmd += ['bash'] + a.args
    else:
        cmd += ['idf.py']
        if a.port:
            cmd += ['--port', a.port]
        if a.command == 'smoke':
            cmd += ['build'] + a.args
        elif a.command == 'idf':
            cmd += a.args
        else:
            cmd += [a.command] + a.args
    return cmd


def main():
    a = parser().parse_args()
    try:
        cmd = launch(a)
        if a.dry_run:
            print(shlex.join(cmd))
            return 0
        return subprocess.call(cmd)
    except (ValueError, OSError) as error:
        print(f'esp32: {error}', file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    sys.exit(main())
